            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--tui", "--process-name", "notepad.exe", "--executable", "C:\\Windows\\System32\\notepad.exe", "--kill-existing", "--no-monitor"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: process-monitor DCS",
